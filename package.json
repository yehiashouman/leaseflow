{
  "name": "leaseflow",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "api",
    "web"
  ],
  "scripts": {
    "test:ops": "node --test scripts/local.test.mjs scripts/governance.test.mjs",
    "build": "npm run build -w api && npm run build -w web",
    "test": "npm run test -w api && npm run test -w web",
    "lint": "npm run lint -w api && npm run lint -w web",
    "format:check": "prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "deepmerge-ts": "^8.0.2",
    "jsdom": "^31.0.0",
    "prettier": "^3.10.0",
    "prisma": "^7.10.1"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "deepmerge-ts": "$deepmerge-ts",
    "mysql2": "^3.24.3",
    "mariadb": "^3.5.4"
  }
}
