{
  "name": "LeaseFlow",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },
  "postCreateCommand": "bash scripts/codespaces-setup.sh",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "LeaseFlow",
      "protocol": "https",
      "onAutoForward": "openBrowser"
    },
    "3000": {
      "label": "LeaseFlow API (internal)",
      "visibility": "private"
    },
    "3306": {
      "label": "MySQL (internal)",
      "visibility": "private"
    },
    "6379": {
      "label": "Redis (internal)",
      "visibility": "private"
    }
  },
  "otherPortsAttributes": {
    "onAutoForward": "silent",
    "visibility": "private"
  },
  "remoteUser": "vscode",
  "customizations": {
    "vscode": {
      "extensions": ["dbaeumer.vscode-eslint", "esbenp.prettier-vscode", "Prisma.prisma"]
    }
  }
}
