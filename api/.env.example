NODE_ENV=development
PORT=3000
LOG_LEVEL=info
DATABASE_URL=mysql://leaseflow:leaseflow@mysql:3306/leaseflow
REDIS_URL=redis://redis:6379
JWT_ACCESS_SECRET=replace-with-32-plus-random-characters
JWT_REFRESH_SECRET=replace-with-different-32-plus-random-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
TRUST_PROXY=127.0.0.1/32,::1/128
DEMO_MODE=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
MAIL_FROM=no-reply@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=leaseflow
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change-me
S3_FORCE_PATH_STYLE=true
EXCHANGE_RATE_PROVIDER_URL=

# Development defaults; production account/file workflows stay gated.
ACCOUNT_EMAIL_ENABLED=false
APP_URL=http://localhost:8080
SMTP_SECURE=false
FILES_ENABLED=false
FILE_MAX_BYTES=5242880
FILE_GRANT_SECONDS=60
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
