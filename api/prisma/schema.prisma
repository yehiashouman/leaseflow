generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum Role {
  ADMIN
  LEASING_MANAGER
  TENANT
}

enum UserStatus {
  PENDING_EMAIL
  PENDING_PHONE
  PENDING_APPROVAL
  ACTIVE
  REJECTED
  SUSPENDED
}

enum SpaceType {
  ROOM
  MASTER_ROOM
  BED_SPACE
  PARTITION
}

enum SpaceStatus {
  AVAILABLE
  OCCUPIED
  PARTIAL
  MAINTENANCE
  INACTIVE
}

enum ContractStatus {
  DRAFT
  ACTIVE
  TRANSFER_PENDING
  MOVE_OUT_PENDING
  CLOSED
  CANCELLED
}

enum PaymentStatus {
  UPCOMING
  DUE
  PARTIALLY_PAID
  PAID
  LATE
  ADJUSTED
  DISPUTED
}

enum RequestType {
  MAINTENANCE
  NEIGHBOR_COMPLAINT
  LATE_PAYMENT
  ROOM_CHANGE
  MOVE_OUT
  KEY_LOCK_CHANGE
  GENERAL
}

enum RequestStatus {
  DRAFT
  SUBMITTED
  SEEN
  AWAITING_MANAGER
  AWAITING_TENANT
  APPROVED
  REJECTED
  IN_PROGRESS
  RESOLVED
  ACCEPTED
  REOPENED
  DEADLOCK
  CLOSED
}

enum DepositEntryType {
  RECEIVED
  DEDUCTION_PROPOSED
  DEDUCTION_ACCEPTED
  DEDUCTION_REJECTED
  REFUND
  ADJUSTMENT
}

enum ExpenseCategory {
  OWNER_RENT
  ELECTRICITY
  WATER
  COOLING
  INTERNET
  MAINTENANCE
  CLEANING
  FURNISHING
  LICENSE_FEE
  OTHER
}

model User {
  id String @id @default(cuid())
  email String @unique
  passwordHash String
  phone String? @unique
  role Role
  status UserStatus @default(PENDING_EMAIL)
  preferredLanguage String @default("en")
  timezone String @default("Asia/Dubai")
  profileVersion Int @default(0)
  notifyEmail Boolean @default(true)
  notifyWhatsapp Boolean @default(true)
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  leasingManager LeasingManagerProfile?
  tenant TenantProfile?
  refreshTokens RefreshToken[]
  authSessions AuthSession[]
  auditEvents AuditEvent[] @relation("AuditActor")
  documentSeries DocumentSeries[]
  phoneChallenge PhoneChallenge?
  accountTokens AccountToken[]
  consents AccountConsent[]
  outboundEmails OutboundEmail[]
  expenseVoids ExpenseVoid[]
  expenseRecoveries ExpenseRecovery[]
}

model LeasingManagerProfile {
  id String @id @default(cuid())
  userId String @unique
  fullName String
  dateOfBirth DateTime?
  nationality String?
  emiratesIdNumber String?
  emiratesIdExpiry DateTime?
  licenseNumber String?
  licenseType String?
  licenseIssuer String?
  licenseExpiry DateTime?
  declarationAcceptedAt DateTime?
  user User @relation(fields: [userId], references: [id])
  landlords Landlord[]
  units Unit[]
  tenants TenantProfile[]
  expenses Expense[]
  pendingPhone String? @db.VarChar(40)
  submittedAt DateTime?
  licenseIssuedAt DateTime?
  invitations TenantInvitation[]
}

model TenantProfile {
  id String @id @default(cuid())
  userId String @unique
  managerId String
  fullName String
  dateOfBirth DateTime?
  nationality String?
  gender String?
  emiratesIdNumber String?
  emiratesIdExpiry DateTime?
  matchingPreferences Json?
  pendingPhone String? @db.VarChar(40)
  lateRequestWindowDays Int @default(10)
  maxLateExtensionDays Int @default(5)
  defaultNoticeDays Int @default(30)
  user User @relation(fields: [userId], references: [id])
  manager LeasingManagerProfile @relation(fields: [managerId], references: [id])
  contracts Contract[]
}

model Landlord {
  id String @id @default(cuid())
  managerId String
  name String
  companyName String? @db.VarChar(200)
  email String?
  phone String?
  whatsapp String?
  address String? @db.VarChar(500)
  notes String? @db.Text
  preferredContactMethod String?
  archivedAt DateTime?
  manager LeasingManagerProfile @relation(fields: [managerId], references: [id])
  units Unit[]
  documentSeries DocumentSeries[]
  expenses Expense[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([managerId])
  @@index([managerId, archivedAt])
}

model Unit {
  id String @id @default(cuid())
  managerId String
  landlordId String?
  name String
  building String?
  street String? @db.VarChar(200)
  addressNotes String? @db.Text
  area String
  emirate String @default("Dubai")
  latitude Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)
  ownerMonthlyRent Decimal? @db.Decimal(12, 2)
  ownerPaymentSchedule String? @db.Text
  currency String @default("AED")
  defaultDeposit Decimal @default(0) @db.Decimal(12, 2)
  amenities Json?
  active Boolean @default(false)
  archivedAt DateTime?
  declarationAcceptedAt DateTime?
  manager LeasingManagerProfile @relation(fields: [managerId], references: [id])
  landlord Landlord? @relation(fields: [landlordId], references: [id])
  spaces RentalSpace[]
  documentSeries DocumentSeries[]
  expenses Expense[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([managerId, active])
  @@index([managerId, archivedAt])
  @@index([landlordId])
}

model RentalSpace {
  id String @id @default(cuid())
  unitId String
  name String
  type SpaceType
  status SpaceStatus @default(AVAILABLE)
  capacity Int @default(1)
  askingRent Decimal? @db.Decimal(12, 2)
  amenities Json?
  enabled Boolean @default(true)
  unit Unit @relation(fields: [unitId], references: [id])
  contracts Contract[]
  expenses Expense[]
  documentSeries DocumentSeries[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([unitId, status])
}

model Contract {
  id String @id @default(cuid())
  tenantId String
  rentalSpaceId String
  status ContractStatus @default(DRAFT)
  startDate DateTime
  endDate DateTime?
  monthlyRent Decimal @db.Decimal(12, 2)
  currency String @default("AED")
  dueDay Int @default(1)
  noticeDays Int @default(30)
  depositAmount Decimal @default(0) @db.Decimal(12, 2)
  secondaryOccupant Json?
  clientId String? @db.VarChar(36)
  payloadHash String? @db.VarChar(64)
  occupants ContractOccupant[]
  tenant TenantProfile @relation(fields: [tenantId], references: [id])
  rentalSpace RentalSpace @relation(fields: [rentalSpaceId], references: [id])
  payments Payment[]
  requests Request[]
  depositEntries DepositEntry[]
  amendments ContractAmendment[]
  reviews ContractReview[]
  expenses Expense[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([tenantId, status])
  @@index([rentalSpaceId, status])
  @@unique([tenantId, clientId])
}

enum OccupantRole {
  PRIMARY
  SECONDARY
}

model ContractOccupant {
  id String @id @default(cuid())
  contractId String
  role OccupantRole
  fullName String @db.VarChar(191)
  dateOfBirth DateTime?
  nationality String? @db.VarChar(100)
  identityCipher String? @db.Text
  identityExpiry DateTime?
  effectiveFrom DateTime
  createdAt DateTime @default(now())
  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  documentSeries DocumentSeries[]
  @@unique([contractId, role])
}

model ContractAmendment {
  id String @id @default(cuid())
  contractId String
  effectiveDate DateTime
  changes Json
  reason String?
  contract Contract @relation(fields: [contractId], references: [id])
  createdAt DateTime @default(now())
}

model ContractReview {
  id String @id @default(cuid())
  contractId String
  dueAt DateTime
  reviewedAt DateTime?
  decision String?
  notes String? @db.Text
  contract Contract @relation(fields: [contractId], references: [id])
  @@index([dueAt, reviewedAt])
}

model Payment {
  id String @id @default(cuid())
  contractId String
  periodStart DateTime
  dueDate DateTime
  amountDue Decimal @db.Decimal(12, 2)
  amountPaid Decimal @default(0) @db.Decimal(12, 2)
  currency String @default("AED")
  exchangeRateToAed Decimal? @db.Decimal(18, 8)
  paidAt DateTime?
  method String?
  reference String?
  evidenceKey String?
  status PaymentStatus @default(UPCOMING)
  contract Contract @relation(fields: [contractId], references: [id])
  createdAt DateTime @default(now())
  documentSeries DocumentSeries[]
  updatedAt DateTime @updatedAt
  @@unique([contractId, periodStart])
  @@index([dueDate, status])
}

model DepositEntry {
  id String @id @default(cuid())
  contractId String
  type DepositEntryType
  amount Decimal @db.Decimal(12, 2)
  description String?
  evidenceKey String?
  tenantAcceptedAt DateTime?
  tenantDisputedAt DateTime?
  contract Contract @relation(fields: [contractId], references: [id])
  createdAt DateTime @default(now())
}

model Request {
  id String @id @default(cuid())
  contractId String
  type RequestType
  status RequestStatus @default(SUBMITTED)
  title String
  description String @db.Text
  metadata Json?
  decisionDueAt DateTime?
  resolvedAt DateTime?
  version Int @default(0)
  clientId String?
  contract Contract @relation(fields: [contractId], references: [id])
  events RequestEvent[]
  documentSeries DocumentSeries[]
  reportJobs CaseReportJob[]
  maintenanceAssessments MaintenanceAssessment[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([contractId, status])
  @@index([decisionDueAt, status])
  @@unique([contractId, clientId])
}

model RequestEvent {
  id String @id @default(cuid())
  requestId String
  actorUserId String?
  actorName String? @db.VarChar(150)
  actorRole Role?
  clientId String?
  sequence Int?
  fromStatus String?
  kind String
  message String? @db.Text
  metadata Json?
  request Request @relation(fields: [requestId], references: [id])
  notifications Notification[]
  createdAt DateTime @default(now())
  @@index([requestId, createdAt])
  @@unique([requestId, clientId])
  @@unique([requestId, sequence])
}

model Notification {
  id String @id @default(cuid())
  recipientUserId String
  eventId String
  readAt DateTime?
  createdAt DateTime @default(now())
  event RequestEvent @relation(fields: [eventId], references: [id])
  @@unique([recipientUserId, eventId])
  @@index([recipientUserId, readAt, createdAt])
}

enum ReportStatus {
  QUEUED
  RUNNING
  COMPLETE
  FAILED
}

enum MaintenanceClassification {
  MANAGER_COST
  TENANT_COST
  UNDER_REVIEW
  NO_COST
}

enum MaintenanceDecision {
  ACCEPTED
  DISPUTED
}

model MaintenanceAssessment {
  id String @id @default(cuid())
  requestId String
  caseVersion Int
  classification MaintenanceClassification
  proposedAmount Decimal? @db.Decimal(12, 2)
  currency String?
  explanation String @db.Text
  evidenceNotes String? @db.Text
  decision MaintenanceDecision?
  responseExplanation String? @db.Text
  respondedAt DateTime?
  createdAt DateTime @default(now())
  request Request @relation(fields: [requestId], references: [id])
  @@unique([requestId, caseVersion])
}

model CaseReportJob {
  id String @id @default(cuid())
  ownerUserId String
  ownerRole Role
  requestId String
  clientId String
  expectedVersion Int
  status ReportStatus @default(QUEUED)
  snapshot Json
  snapshotHash String @db.VarChar(64)
  pdfBytes Bytes? @db.MediumBlob
  pdfHash String? @db.VarChar(64)
  attempts Int @default(0)
  retryCount Int @default(0)
  leaseToken String?
  leaseExpiresAt DateTime?
  failureCode String?
  createdAt DateTime @default(now())
  generatedAt DateTime?
  completedAt DateTime?
  request Request @relation(fields: [requestId], references: [id])
  @@unique([ownerUserId, clientId])
  @@index([status, createdAt])
  @@index([ownerUserId, requestId, createdAt])
}

model Expense {
  id String @id @default(cuid())
  managerId String
  unitId String?
  landlordId String?
  rentalSpaceId String?
  contractId String?
  scopeKind String @default("PORTFOLIO") @db.VarChar(20)
  clientId String? @db.VarChar(36)
  payloadHash String? @db.VarChar(64)
  category ExpenseCategory
  amount Decimal @db.Decimal(12, 2)
  currency String @default("AED")
  exchangeRateToAed Decimal? @db.Decimal(18, 8)
  incurredAt DateTime
  vendor String? @db.VarChar(200)
  description String? @db.Text
  evidenceKey String?
  createdAt DateTime @default(now())
  manager LeasingManagerProfile @relation(fields: [managerId], references: [id])
  unit Unit? @relation(fields: [unitId], references: [id])
  landlord Landlord? @relation(fields: [landlordId], references: [id], onDelete: Restrict)
  rentalSpace RentalSpace? @relation(fields: [rentalSpaceId], references: [id], onDelete: Restrict)
  contract Contract? @relation(fields: [contractId], references: [id], onDelete: Restrict)
  void ExpenseVoid?
  recoveries ExpenseRecovery[]
  documentSeries DocumentSeries[]
  @@unique([managerId, clientId])
  @@index([managerId, incurredAt])
  @@index([managerId, category, incurredAt])
  @@index([landlordId])
  @@index([rentalSpaceId])
  @@index([contractId])
}

model ExpenseVoid {
  id String @id @default(cuid())
  expenseId String @unique
  actorUserId String
  clientId String @db.VarChar(36)
  reason String @db.VarChar(1000)
  createdAt DateTime @default(now())
  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Restrict)
  actor User @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
}

model ExpenseRecovery {
  id String @id @default(cuid())
  expenseId String
  actorUserId String
  clientId String @db.VarChar(36)
  payloadHash String @db.VarChar(64)
  amount Decimal @db.Decimal(12, 2)
  paidAt DateTime
  method String @db.VarChar(80)
  reference String? @db.VarChar(200)
  notes String? @db.Text
  createdAt DateTime @default(now())
  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Restrict)
  actor User @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  @@unique([expenseId, clientId])
}

model RefreshToken {
  id String @id @default(cuid())
  userId String
  tokenHash String @unique
  expiresAt DateTime
  revokedAt DateTime?
  sessionId String?
  session AuthSession? @relation(fields: [sessionId], references: [id])
  user User @relation(fields: [userId], references: [id])
  @@index([userId, expiresAt])
  @@index([sessionId])
}

model AuthSession {
  id String @id @default(cuid())
  userId String
  createdAt DateTime @default(now())
  lastUsedAt DateTime @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  ip String?
  userAgent String? @db.VarChar(500)
  user User @relation(fields: [userId], references: [id])
  refreshTokens RefreshToken[]
  @@index([userId, revokedAt, expiresAt])
}

model AuditEvent {
  id String @id @default(cuid())
  actorUserId String?
  action String
  entityType String
  entityId String?
  oldValue Json?
  newValue Json?
  ip String?
  userAgent String? @db.Text
  actor User? @relation("AuditActor", fields: [actorUserId], references: [id])
  createdAt DateTime @default(now())
  @@index([entityType, entityId, createdAt])
}


enum DocumentPurpose {
  IDENTITY
  LICENSE
  LANDLORD_DOCUMENT
  PROPERTY_DOCUMENT
  CONSENT
  UNIT_PHOTO
  COMMON_PHOTO
  SPACE_PHOTO
  CASE_EVIDENCE
  PAYMENT_EVIDENCE
  EXPENSE_EVIDENCE
  OCCUPANT_IDENTITY
}

enum ScanStatus {
  QUARANTINED
  SCANNING
  CLEAN
  REJECTED
  FAILED
}

model DocumentSeries {
  id String @id @default(cuid())
  ownerUserId String
  purpose DocumentPurpose
  landlordId String?
  unitId String?
  rentalSpaceId String?
  requestId String?
  paymentId String?
  expenseId String?
  occupantId String?
  createdAt DateTime @default(now())
  owner User @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  landlord Landlord? @relation(fields: [landlordId], references: [id], onDelete: Restrict)
  unit Unit? @relation(fields: [unitId], references: [id], onDelete: Restrict)
  rentalSpace RentalSpace? @relation(fields: [rentalSpaceId], references: [id], onDelete: Restrict)
  request Request? @relation(fields: [requestId], references: [id], onDelete: Restrict)
  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  expense Expense? @relation(fields: [expenseId], references: [id], onDelete: Restrict)
  occupant ContractOccupant? @relation(fields: [occupantId], references: [id], onDelete: Restrict)
  versions Document[]
  @@index([ownerUserId, createdAt])
  @@index([landlordId])
  @@index([unitId])
  @@index([rentalSpaceId])
  @@index([requestId])
  @@index([paymentId])
  @@index([expenseId])
  @@index([occupantId])
}

model Document {
  id String @id @default(cuid())
  seriesId String
  version Int
  uploaderUserId String
  clientId String
  payloadHash String @db.VarChar(64)
  title String @db.VarChar(150)
  originalName String @db.VarChar(150)
  mimeType String @db.VarChar(80)
  originalSize Int
  fileSize Int?
  sourceHash String @db.VarChar(64)
  fileHash String? @db.VarChar(64)
  quarantineKey String @unique
  cleanKey String? @unique
  expiresAt DateTime?
  status ScanStatus @default(QUARANTINED)
  attempts Int @default(0)
  retryCount Int @default(0)
  nextAttemptAt DateTime @default(now())
  leaseToken String?
  leaseExpiresAt DateTime?
  failureCode String? @db.VarChar(80)
  scannedAt DateTime?
  createdAt DateTime @default(now())
  series DocumentSeries @relation(fields: [seriesId], references: [id], onDelete: Restrict)
  @@unique([seriesId, version])
  @@unique([uploaderUserId, clientId])
  @@index([status, nextAttemptAt, createdAt])
}


enum AccountTokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
}

model AccountToken {
  id String @id @default(cuid())
  userId String
  type AccountTokenType
  tokenHash String @unique @db.VarChar(64)
  expiresAt DateTime
  usedAt DateTime?
  revokedAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@index([userId, type, createdAt])
}

model AccountConsent {
  id String @id @default(cuid())
  userId String
  version String @db.VarChar(80)
  textHash String @db.VarChar(64)
  acceptedAt DateTime @default(now())
  sessionId String
  ip String @db.VarChar(100)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@unique([userId, version])
}

model TenantInvitation {
  id String @id @default(cuid())
  managerId String
  email String @db.VarChar(191)
  fullName String @db.VarChar(150)
  clientId String
  tokenHash String @unique @db.VarChar(64)
  expiresAt DateTime
  acceptedAt DateTime?
  revokedAt DateTime?
  resendCount Int @default(0)
  lastSentAt DateTime @default(now())
  createdAt DateTime @default(now())
  manager LeasingManagerProfile @relation(fields: [managerId], references: [id], onDelete: Restrict)
  @@unique([managerId, clientId])
  @@index([managerId, email, createdAt])
}

model OutboundEmail {
  id String @id @default(cuid())
  userId String?
  recipient String @db.VarChar(191)
  template String @db.VarChar(80)
  language String @default("en")
  encryptedPayload String @db.Text
  status ReportStatus @default(QUEUED)
  attempts Int @default(0)
  retryCount Int @default(0)
  nextAttemptAt DateTime @default(now())
  leaseToken String?
  leaseExpiresAt DateTime?
  failureCode String? @db.VarChar(80)
  providerId String? @db.VarChar(191)
  deliveredAt DateTime?
  createdAt DateTime @default(now())
  user User? @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@index([status, nextAttemptAt, createdAt])
  @@index([userId, createdAt])
}

model PhoneChallenge {
  id String @id @default(cuid())
  userId String @unique
  phone String @db.VarChar(40)
  providerId String? @db.VarChar(191)
  attempts Int @default(0)
  sends Int @default(0)
  expiresAt DateTime
  lastSentAt DateTime
  consumedAt DateTime?
  leaseToken String?
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
}
